.env
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
dist/
/build/
*.egg-info/
# Blender/agent run artifacts
runs/
*.blend1
# regenerable asset cache (model.glb is the pinned input; raw.glb is not)
shots/*/assets/*/raw.glb
nohup.out
# shot folders: local working data (briefs/refs/outputs) — not tracked
shots/
# stray probe renders at the repo root (shots keep their own)
renders/
# ledger write-lock sidecars and in-flight atomic writes
*.json.lock
*.json.tmp.*
# eval baselines: they embed build-script bodies and judged-render hashes, i.e. shot
# content, and shots/ is untracked for exactly that reason. Measurements are local.
evals/
